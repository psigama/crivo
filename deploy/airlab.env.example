# Configuração da aplicação na VPS (perfil prod). Copie para /etc/airlab/airlab.env, com dono root
# e permissão 600 (Constitution, regra de implantação 7 — segredos nunca no repositório):
#
#   sudo install -D -o root -g root -m 600 deploy/airlab.env.example /etc/airlab/airlab.env
#
# É o EnvironmentFile da unidade deploy/airlab.service. No perfil prod a falta de uma variável
# obrigatória interrompe a inicialização com mensagem clara, nunca com um padrão silencioso
# (Constitution, regra de linha de comando 3). Para desenvolvimento, o modelo é o .env.example da
# raiz, onde nada disto é obrigatório.
#
# Preparo da VPS, papéis do banco e geração das chaves: docs/DEPLOY.md, seção 1.

# ---- banco (PostgreSQL do sistema, só em 127.0.0.1; regra de implantação 4) ----
AIRLAB_DB_URL=jdbc:postgresql://127.0.0.1:5432/airlab
AIRLAB_DB_USER=airlab_app
AIRLAB_DB_PASSWORD=
# O Flyway migra como o dono do banco; a aplicação conecta como airlab_app, que a migração V10
# reduz ao privilégio mínimo.
SPRING_FLYWAY_USER=airlab_owner
SPRING_FLYWAY_PASSWORD=

# ---- chaves e credenciais ----
# AES-256 em Base64, para os campos do esquema identity e a custódia da semente:
#   openssl rand -base64 32
# GUARDE UMA CÓPIA FORA DA VPS: sem ela, os dados cifrados não se recuperam.
AIRLAB_IDENTITY_KEY=
# Credencial do pesquisador: só o hash bcrypt entra aqui, gerado fora da VPS.
AIRLAB_RESEARCHER_USER=pesquisador
AIRLAB_RESEARCHER_PASSWORD_HASH=

# ---- endereço público ----
# A instalação é única e tem um endereço só (SPEC 0.29, seção 1.3): o site estático e a aplicação
# atrás do mesmo Caddy. Este endereço vai nos links dos e-mails, que saem fora de uma requisição, e
# na imagem de compartilhamento (og:image), que o Open Graph exige absoluta.
AIRLAB_BASE_URL=https://crivo.psigama.com
# Deixe VAZIA na instalação única. Ela existe para quando o site mora noutro endereço: definida, a
# aplicação responde às rotas editoriais com 301 para ela — e, sendo o mesmo endereço, seria um 301
# para si mesma. Vazia, a aplicação serve essas páginas ela mesma, o que aqui é a rede de segurança
# para o caso de o Caddy não encontrar o arquivo estático.
AIRLAB_SITE_URL=

# ---- e-mail (SPEC E13; E10, travas 3 e 5) ----
# Sem SPRING_MAIL_HOST, a aplicação conta como sem e-mail e a inscrição de contas fica fechada no
# perfil prod. O SMTP fica fora do /actuator/health, que a implantação confere.
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
AIRLAB_MAIL_FROM=
# Contato humano mostrado na inscrição (E10, trava 5) e, opcionalmente, quem recebe os avisos de
# etapa concluída (eles sempre aparecem no painel).
AIRLAB_CONTACT_EMAIL=
AIRLAB_ADMIN_EMAIL=

# Referência da aprovação do comitê de ética (CEP/Plataforma Brasil). Sem ela, em produção, a
# criação de conta e o pedido de consulta do P1 ficam fechados (SPEC E10, trava 4).
AIRLAB_CEP_REFERENCE=

# ---- trilha ----
# Carimbo de tempo externo (SPEC E8, RFC 3161, FreeTSA): exige saída HTTPS para freetsa.org; só o
# hash da cabeça da trilha sai, nunca conteúdo.
AIRLAB_TIMESTAMP_ENABLED=true

# ---- rede e disco ----
# A aplicação escuta só em loopback; o Caddy atende a internet e faz o HTTPS (regra 3).
AIRLAB_BIND=127.0.0.1
AIRLAB_PORT=8080
# Dados e mídia, na pasta que só o usuário airlab lê (ReadWritePaths da unidade systemd).
AIRLAB_STORAGE_PATH=/opt/airlab/data/media
