# Crivo (AIR Lab) — a aplicação como serviço do sistema na VPS (perfil prod, Linux).
#
# Instalação:
#   sudo cp deploy/airlab.service /etc/systemd/system/airlab.service
#   sudo systemctl daemon-reload && sudo systemctl enable airlab
#
# O serviço só sobe quando houver um JAR em /opt/airlab/airlab.jar, o que a primeira implantação
# resolve (docs/DEPLOY.md, seção 4); daí em diante, cada push na main troca esse arquivo e reinicia
# o serviço. As páginas editoriais não passam por aqui: são arquivos estáticos que o Caddy serve de
# /var/www/crivo (deploy/Caddyfile.example).
#
# A configuração e os segredos ficam em /etc/airlab/airlab.env, com permissão 600 e dono root
# (Constitution, regra de implantação 7), a partir de deploy/airlab.env.example. Nunca no
# repositório.

[Unit]
Description=Crivo (AIR Lab)
Documentation=https://github.com/psigama/crivo
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=simple
User=airlab
Group=airlab
WorkingDirectory=/opt/airlab
EnvironmentFile=/etc/airlab/airlab.env
ExecStart=/usr/bin/java -jar /opt/airlab/airlab.jar --spring.profiles.active=prod
Restart=on-failure
RestartSec=5
SuccessExitStatus=143

# A aplicação escuta em loopback; o Caddy faz o HTTPS na borda.
# Endurecimento: ela só precisa escrever no diretório de dados.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/airlab/data
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
